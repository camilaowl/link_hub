<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Santehstyl" suffix=" · Plumbing, heating & filtration" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta
      name="description"
      content="Santehstyl provides plumbing, heating, and water filtration services. Call or message us to discuss your project."
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="m-0 min-w-80 antialiased">
    {@inner_content}
  </body>
</html>
