<main
  id="contact-page"
  class="relative isolate flex min-h-dvh overflow-hidden bg-[#f4f1e8] text-[#171814]"
>
  <div class="contact-glow contact-glow--top" aria-hidden="true"></div>
  <div class="contact-glow contact-glow--bottom" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-dvh w-full max-w-xl flex-col justify-center px-5 py-12 sm:px-8">
    <a
      id="home-link"
      href={~p"/"}
      class="mx-auto mb-12 block w-full max-w-[28rem] rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-[#0873ce]"
      aria-label="Santehstyl home"
    >
      <img
        src={~p"/images/santehstyl-logo.png"}
        width="454"
        height="124"
        alt="Santehstyl"
        class="h-auto w-full"
      />
    </a>

    <nav id="contact-links" class="grid gap-3" aria-label="Contact links">
      <a
        id="phone-link"
        href="tel:+380631326012"
        class="contact-link group"
        aria-label="Call Santehstyl at +380 63 132 60 12"
      >
        <span class="contact-link__icon contact-link__icon--phone contact-link__icon--round bg-[#f1b944] text-[#171814]">
          <.icon name="hero-phone" class="size-6" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="contact-link__value">+380 63 132 60 12</span>
        </span>
        <span class="contact-link__arrow" aria-hidden="true">
          <.icon name="hero-arrow-up-right" class="size-5" />
        </span>
      </a>

      <a
        id="telegram-link"
        href="https://t.me/+380631326012"
        target="_blank"
        rel="noreferrer"
        class="contact-link group"
        aria-label="Message Santehstyl on Telegram"
      >
        <span class="contact-link__icon contact-link__icon--brand">
          <img
            src={~p"/images/Telegram_logo.svg"}
            alt=""
            class="size-full object-contain"
          />
        </span>
        <span class="min-w-0 flex-1">
          <span class="contact-link__value">Telegram</span>
        </span>
        <span class="contact-link__arrow" aria-hidden="true">
          <.icon name="hero-arrow-up-right" class="size-5" />
        </span>
      </a>

      <a
        id="viber-link"
        href="viber://chat?number=%2B380631326012"
        class="contact-link group"
        aria-label="Message Santehstyl on Viber"
      >
        <span class="contact-link__icon contact-link__icon--brand">
          <img
            src={~p"/images/Chat_on_Viber_icon.svg"}
            alt=""
            class="size-full object-contain"
          />
        </span>
        <span class="min-w-0 flex-1">
          <span class="contact-link__value">Viber</span>
        </span>
        <span class="contact-link__arrow" aria-hidden="true">
          <.icon name="hero-arrow-up-right" class="size-5" />
        </span>
      </a>

      <a
        id="whatsapp-link"
        href="https://wa.me/380631326012"
        target="_blank"
        rel="noreferrer"
        class="contact-link group"
        aria-label="Message Santehstyl on WhatsApp"
      >
        <span class="contact-link__icon contact-link__icon--brand">
          <img
            src={~p"/images/whatsapp-com-logo.svg"}
            alt=""
            class="size-full object-contain"
          />
        </span>
        <span class="min-w-0 flex-1">
          <span class="contact-link__value">WhatsApp</span>
        </span>
        <span class="contact-link__arrow" aria-hidden="true">
          <.icon name="hero-arrow-up-right" class="size-5" />
        </span>
      </a>

      <a
        id="tiktok-link"
        href="https://www.tiktok.com/@santehstyl.ua?_r=1&_t=ZS-9BTZwjj0I2K"
        target="_blank"
        rel="noreferrer"
        class="contact-link group"
        aria-label="Follow Santehstyl on TikTok"
      >
        <span class="contact-link__icon contact-link__icon--brand contact-link__icon--tiktok">
          <img
            src={~p"/images/tiktok-com-logo.png"}
            alt=""
            class="size-full object-contain"
          />
        </span>
        <span class="min-w-0 flex-1">
          <span class="contact-link__value">TikTok</span>
        </span>
        <span class="contact-link__arrow" aria-hidden="true">
          <.icon name="hero-arrow-up-right" class="size-5" />
        </span>
      </a>
    </nav>
  </div>
</main>
